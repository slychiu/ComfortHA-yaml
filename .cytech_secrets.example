TAILSCALE_CLIENT_ID=your-oauth-client-id
TAILSCALE_CLIENT_SECRET=tskey-client-your-secret-here
# Keep /main/manifest.json -- do NOT pin this to a tag or a commit: file
# downloads use the manifest's git_tag field (a per-version URL that GitHub's
# CDN can never serve from cache), and the manifest itself is only read from
# this URL.
CYTECH_MANIFEST_URL=https://raw.githubusercontent.com/slychiu/ComfortHA-yaml/main/manifest.json
